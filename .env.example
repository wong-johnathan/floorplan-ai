# ═══════════════════════════════════════════════════════════
# floorplan-ai — Environment Template
# Copy this to .env.dev or .env.local and fill in secrets
# ═══════════════════════════════════════════════════════════

# ── Backend ──
BACKEND_PORT=4000
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/floorplan_ai
DATABASE_URL_LOCAL=postgresql://postgres:changeme@localhost:5432/floorplan_ai
REDIS_URL=redis://redis:6379
REDIS_URL_LOCAL=redis://localhost:6379
NODE_ENV=development

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ── Database (Postgres) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=floorplan_ai

# ── AI Providers ──
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
GEMINI_API_KEY=your-gemini-api-key
