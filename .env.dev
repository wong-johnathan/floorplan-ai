# ═══════════════════════════════════════════════════════════
# floorplan-ai — Development Environment (tracked by git)
# Override secrets locally in .env.local
# ═══════════════════════════════════════════════════════════

# ── Backend ──
BACKEND_PORT=4000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/floorplan_ai
REDIS_URL=redis://redis:6379
NODE_ENV=development

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ── Database (Postgres) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=floorplan_ai

# ── AI Providers (fill in .env.local) ──
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
